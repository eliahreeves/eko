#!/usr/bin/env bash
STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep "eko_app/.*\.dart$")

if [ -z "$STAGED_DART_FILES" ]; then
    exit 0
fi

echo "--- Pre-commit: Formatting Dart files ---"

REPO_ROOT=$(git rev-parse --show-toplevel)

cd "$REPO_ROOT" || exit
eval "$(direnv export bash 2>/dev/null)"
dart format .

echo "$STAGED_DART_FILES" | while read -r FILE; do
    if [ -f "$FILE" ]; then
        git add "$FILE"
    fi
done

echo "--- Pre-commit: Done ---"
exit 0
